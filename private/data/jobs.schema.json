{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhanh-he.github.io/finding-jobs/private/data/jobs.schema.json",
  "title": "finding-jobs canonical registry 2.1",
  "description": "Canonical records include vacancies, team watches and historical records; counts are not an application inventory. stdlib validator also checks source references, scoring, aliases and files.",
  "type": "object",
  "required": [
    "schema_version",
    "as_of",
    "weights",
    "sources",
    "jobs"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "as_of": {
      "type": "string"
    },
    "weights": {
      "type": "object",
      "required": [
        "research",
        "technical",
        "academic",
        "engineering",
        "location_lifestyle",
        "salary_development",
        "interview_competitiveness"
      ],
      "properties": {
        "research": {
          "const": 20
        },
        "technical": {
          "const": 20
        },
        "academic": {
          "const": 10
        },
        "engineering": {
          "const": 10
        },
        "location_lifestyle": {
          "const": 25
        },
        "salary_development": {
          "const": 10
        },
        "interview_competitiveness": {
          "const": 5
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/job"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "job": {
      "type": "object",
      "required": [
        "id",
        "record_type",
        "organization",
        "title",
        "source_ids",
        "vacancy_status",
        "verified_open",
        "public_fact_eligible",
        "scores",
        "known_weight",
        "coverage_pct",
        "provisional_overall",
        "career_fit_score",
        "career_fit_coverage_pct",
        "artifacts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "record_type": {
          "enum": [
            "vacancy",
            "watch",
            "history"
          ]
        },
        "organization": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "vacancy_status": {
          "enum": [
            "open",
            "closed",
            "unknown",
            "upcoming"
          ]
        },
        "verified_open": {
          "type": "boolean"
        },
        "public_fact_eligible": {
          "type": "boolean"
        },
        "api_active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "locations": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "properties": {
              "country": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "city": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "seniority_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "research_direction_fit": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "level": {
              "enum": [
                "high",
                "medium",
                "low",
                "unknown"
              ]
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "level",
            "label",
            "reason"
          ],
          "additionalProperties": true
        },
        "level_fit": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "level": {
              "enum": [
                "high",
                "medium",
                "low",
                "unknown"
              ]
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "level",
            "label",
            "reason"
          ],
          "additionalProperties": true
        },
        "application_action": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "category": {
              "enum": [
                "primary",
                "conditional",
                "stretch",
                "watch_reopen",
                "watch_team",
                "do_not_apply"
              ]
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "category",
            "label",
            "reason"
          ],
          "additionalProperties": true
        },
        "key_gaps": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "scores": {
          "type": "object",
          "required": [
            "research",
            "technical",
            "academic",
            "engineering",
            "location_lifestyle",
            "salary_development",
            "interview_competitiveness"
          ],
          "properties": {
            "research": {
              "$ref": "#/$defs/score"
            },
            "technical": {
              "$ref": "#/$defs/score"
            },
            "academic": {
              "$ref": "#/$defs/score"
            },
            "engineering": {
              "$ref": "#/$defs/score"
            },
            "location_lifestyle": {
              "$ref": "#/$defs/score"
            },
            "salary_development": {
              "$ref": "#/$defs/score"
            },
            "interview_competitiveness": {
              "$ref": "#/$defs/score"
            }
          },
          "additionalProperties": false
        },
        "known_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "coverage_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "provisional_overall": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "computed_provisional_overall": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "career_fit_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "career_fit_coverage_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "draft_material_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "requirements_official": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "category",
              "requirement",
              "source_id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "responsibility",
                  "core_expectation",
                  "preferred"
                ]
              },
              "requirement": {
                "type": "string"
              },
              "source_id": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "essential_requirements": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "preferred_requirements": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "score": {
      "type": "object",
      "required": [
        "value",
        "weight"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "type",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
